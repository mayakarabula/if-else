{
  "name": "if-else",
  "private": true,
  "scripts": {
    "dev": "npm run dev:backend & npm run dev:frontend",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "cli": "npm --prefix backend run cli --",
    "mcp": "npm --prefix backend run mcp",
    "wiki": "npm --prefix wiki run dev -- --port 5174",
    "wiki:build": "npm --prefix wiki run build",
    "wiki:preview": "npm --prefix wiki run preview -- --port 5174",
    "install:all": "npm --prefix backend install && npm --prefix frontend install && npm --prefix wiki install"
  }
}
