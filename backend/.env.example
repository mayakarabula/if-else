# Server
PORT=3001
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-string

# Redis (bee-queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
WORKER_CONCURRENCY=2

# Persistent data root (Docker sets DATA_ROOT=/data)
# DATA_ROOT=

# Optional default OAuth client for Google Docs / Sheets integrations
# (override per-integration under Integrations in the UI).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Cursor Cloud Agents — default API key for Cursor integration AND in-app Agent chat.
# CURSOR_API_KEY=

# In-app agent chat — prefer Integrations → Agent chat in the UI.
# With only CURSOR_API_KEY set, Auto uses Cursor.
# CHAT_PROVIDER=auto
# CHAT_API_KEY=
# OPENAI_API_KEY=   # fallback if CHAT_API_KEY is unset
# CHAT_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o-mini
# CHAT_CURSOR_MODEL=
# CHAT_CURSOR_REPO_URL=
# CHAT_CURSOR_STARTING_REF=main
