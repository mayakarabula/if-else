# Server
PORT=3001
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-string

# Redis (bee-queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
WORKER_CONCURRENCY=2

# Persistent data root (Docker sets DATA_ROOT=/data)
# DATA_ROOT=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly.
# Also reused as the default client for Google Docs / Sheets integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# Optional default for the Cursor Agent integration (Cloud Agents API).
# CURSOR_API_KEY=

# In-app agent chat — prefer Integrations → Agent chat in the UI.
# CHAT_PROVIDER=auto
# CHAT_API_KEY=
# OPENAI_API_KEY=   # fallback if CHAT_API_KEY is unset
# CHAT_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o-mini
# CHAT_CURSOR_MODEL=
# CHAT_CURSOR_REPO_URL=
# CHAT_CURSOR_STARTING_REF=main
